{
  "openapi": "3.1.0",
  "info": {
    "title": "Verified Inference",
    "version": "0.8.1"
  },
  "paths": {
    "/v1/models": {
      "get": {
        "summary": "List available attested inference models",
        "operationId": "models_v1_models_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/attestation": {
      "get": {
        "summary": "Fetch the current SNP attestation document",
        "operationId": "attestation_v1_attestation_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/v1/chat/completions": {
      "post": {
        "summary": "Generate an attested chat completion",
        "operationId": "chat_completions_v1_chat_completions_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "402": {
            "description": "x402 payment required; see the PAYMENT-REQUIRED header."
          }
        }
      }
    },
    "/v1/receipts/{receipt_id}": {
      "get": {
        "summary": "Fetch a signed inference receipt",
        "operationId": "get_receipt_v1_receipts__receipt_id__get",
        "parameters": [
          {
            "name": "receipt_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Receipt Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthSessionRequest": {
        "properties": {
          "access_code": {
            "type": "string",
            "maxLength": 512,
            "minLength": 1,
            "title": "Access Code"
          }
        },
        "type": "object",
        "required": [
          "access_code"
        ],
        "title": "AuthSessionRequest"
      },
      "ChatRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Model"
          },
          "messages": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "maxItems": 128,
            "minItems": 1,
            "title": "Messages"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 131072.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 256
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "model",
          "messages"
        ],
        "title": "ChatRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InferRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Model"
          },
          "prompt": {
            "type": "string",
            "maxLength": 524288,
            "title": "Prompt"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 64
          }
        },
        "type": "object",
        "required": [
          "model",
          "prompt"
        ],
        "title": "InferRequest"
      },
      "SealedInferRequest": {
        "properties": {
          "model": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Model"
          },
          "enc": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Enc"
          },
          "ciphertext": {
            "type": "string",
            "maxLength": 900000,
            "minLength": 1,
            "title": "Ciphertext"
          },
          "max_tokens": {
            "type": "integer",
            "maximum": 4096.0,
            "minimum": 1.0,
            "title": "Max Tokens",
            "default": 64
          },
          "stream": {
            "type": "boolean",
            "title": "Stream",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "model",
          "enc",
          "ciphertext"
        ],
        "title": "SealedInferRequest"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  },
  "servers": [
    {
      "url": "https://pay.example.invalid"
    }
  ]
}
