# ── Secrets: these patterns exist BEFORE any secret file can (standing rule) ──
.env
.env.*
!.env.example
*.pem
*.key
*.keypair.json
solana/.devnet-deployer.json
id_ed25519*
id_rsa*
*_rsa
*.p12
secrets/
**/enclave-keys/
anthropic_key*
ANTHROPIC_API_KEY*

# Solana local keypairs / ledgers
solana/target/deploy/*-keypair.json
test-ledger/
.anchor/

# Model weights — live on the box's NVMe, never in git
models/
*.gguf
*.safetensors
*.bin

# Tachyon is PRIVATE — never vendored here
tachyon/
zk/tachyon/

# Build / runtime junk
__pycache__/
*.pyc
.venv/
venv/
node_modules/
.next/
target/
dist/
build/
*.egg-info/
.pytest_cache/
.ruff_cache/
.DS_Store

# Local-only run artifacts (real, curated runs are committed under runs/; no
# synthetic/mock fixtures exist any more — "real only" per project deviation)
runs/_scratch/
*.log

# Generated artifacts (regenerate from sources; never the source of truth)
payskill/generated/
report/out/
