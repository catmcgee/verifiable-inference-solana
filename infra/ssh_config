# Sunburst box — merge into your ~/.ssh/config.
# Standing rule: the IdentityFile line (key PATH) lives ONLY in your own
# ~/.ssh/config, never in this checked-in file. The private key itself is
# never read, printed, or copied anywhere.
#
# In your ~/.ssh/config add:
#   Host sunburst
#       IdentityFile ~/.ssh/id_ed25519_sunburst
#       IdentitiesOnly yes
# plus the HostName/User below once known.

Host sunburst
    HostName 213.239.141.40          # instance cat-verif, project Cat, sunburst.monogon.dev
    User ubuntu
    ServerAliveInterval 30
    ServerAliveCountMax 4
    ControlMaster auto
    ControlPath ~/.ssh/cm-%r@%h:%p
    ControlPersist 10m
