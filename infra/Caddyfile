vinfer.usefrogpay.com {
	encode zstd gzip
	@body_too_large header_regexp Content-Length ^[0-9]{7,}$
	respond @body_too_large "request body too large" 413
	request_body {
		max_size 1MB
	}
	handle_path /vinfer-a/* {
		reverse_proxy 127.0.0.1:8481 {
			flush_interval -1
		}
	}

	handle_path /vinfer-c/* {
		reverse_proxy 127.0.0.1:8482 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:8479 {
			flush_interval -1
		}
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}
}
