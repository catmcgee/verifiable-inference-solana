# Origin access is disabled unless explicitly required.
VINFER_REQUIRE_AUTH=0
VINFER_AUTH_TOKEN=
VINFER_AUTH_SESSION_TTL=28800
VINFER_AUTH_COOKIE_PATH=/
VINFER_AUTH_SECURE_COOKIE=1

# External pay gateway injects this as Authorization: Bearer after payment.
VINFER_ORIGIN_TOKEN=
VINFER_PAY_URL=http://127.0.0.1:1402
